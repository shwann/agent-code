FROM node:22-bookworm-slim AS node-runtime

FROM oven/bun:1

WORKDIR /app

ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    git \
    openssh-client \
    python-is-python3 \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY package.json bunfig.toml ./
COPY bun.lock ./
RUN bun install --production --frozen-lockfile

COPY adapters/package.json adapters/bun.lock ./adapters/
RUN cd adapters && bun install --production --frozen-lockfile

COPY preload.ts tsconfig.json ./
COPY bin/ ./bin/
COPY src/ ./src/
COPY adapters/ ./adapters/
COPY desktop/sidecars/ ./desktop/sidecars/
COPY runtime/ ./runtime/
COPY stubs/ ./stubs/
COPY docker/entrypoint.server.sh /usr/local/bin/agent-code-entrypoint
COPY docker/run-combined.sh /usr/local/bin/agent-code-combined
RUN chmod +x /usr/local/bin/agent-code-entrypoint /usr/local/bin/agent-code-combined

ENV NODE_ENV=production \
  SERVER_HOST=0.0.0.0 \
  SERVER_PORT=3456 \
  AGENT_CODE_RUN_USER=agentcode \
  AGENT_CODE_UID=1001 \
  AGENT_CODE_GID=1001 \
  AGENT_CODE_HOME=/home/agentcode \
  CLAUDE_CONFIG_DIR=/home/agentcode/.claude \
  AGENT_CODE_WORKSPACE_DIR=/workspace

EXPOSE 3456

ENTRYPOINT ["agent-code-entrypoint"]
CMD ["/usr/local/bin/agent-code-combined"]
